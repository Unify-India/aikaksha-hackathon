rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'teacher' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'teacher'
      );
    }

    // Answer sheet uploads under answer_sheets/{teacherId}/{submissionId}
    match /answer_sheets/{teacherId}/{submissionId}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.uid == teacherId || 
        isAdmin() ||
        firestore.get(/databases/(default)/documents/submissions/$(submissionId)).data.studentId == request.auth.uid
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == teacherId ||
        isAdmin() ||
        request.auth.uid == request.resource.metadata.studentId
      ) && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf)');
    }

    // Question media / Diagrams
    match /questions/{questionId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if (isTeacher() || isAdmin())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|application/pdf)');
    }

    // Workflow B — question paper and answer sheet PDFs (renamed; never the student's name in the path).
    // ⚠ HACKATHON POC: OPEN ACCESS WITHOUT LOGIN, PDFs only, max 30 MB, no deletes.
    // Switches itself OFF on 2026-12-20 (cost/abuse safety). Lock down once the app uses Firebase Auth.
    match /question_papers/{paperId}/{fileName} {
      allow read: if request.time < timestamp.date(2026, 12, 20);
      allow create, update: if request.time < timestamp.date(2026, 12, 20)
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
    match /question_papers/{paperId}/answer_sheets/{fileName} {
      allow read: if request.time < timestamp.date(2026, 12, 20);
      allow create, update: if request.time < timestamp.date(2026, 12, 20)
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Default fallback deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
