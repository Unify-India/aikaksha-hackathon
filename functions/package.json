{
  "name": "ai-kaksha-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for AI Kaksha Voice & Autonomous Exam Platform",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^6.3.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  },
  "private": true
}
