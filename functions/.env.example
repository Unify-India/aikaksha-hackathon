# Local Cloud Functions development environment variables
# Copy this file to .env and insert your real Gemini API key:
#   cp .env.example .env

# Server & Runtime Configuration
PORT=5001
NODE_ENV=development
DEPLOYMENT_REGION=us-central1
DEMO_TOKEN=demo-token-123
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Google Gemini API Key (Secret Manager in production, .env for local development)
# When empty, the backend automatically runs in safe Mock/Dry-Run mode!
GEMINI_API_KEY=

# Google Cloud Platform & Vision API Configuration (Optional / ADC)
GOOGLE_CLOUD_PROJECT=ai-kaksha-poc
GOOGLE_CLOUD_LOCATION=us-central1

# Feature Toggles
ENABLE_MOCK_FALLBACK=true
ENABLE_NANO_BANANA_VISUAL_AIDS=true
ENABLE_VISION_OCR_HYBRID=true
