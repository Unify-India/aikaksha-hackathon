# Local development only. Copy to .env and populate locally.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Choose ONE Gemini access path for the POC and document the choice.
# Option A: Gemini Developer API (AI Studio)
GEMINI_API_KEY=

# Option B: Vertex AI / Google Cloud (prefer ADC locally; do not store keys here)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=

# Firebase / application integration — populate only after repository inspection.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Auth configuration — exact issuer/audience/JWKS values depend on approved OAuth design.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_REQUIRED_SCOPES=

# Abhyas integration — do not invent URLs or credentials.
ABHYAS_API_BASE_URL=
ABHYAS_INTEGRATION_MODE=adapter

# Storage and document processing
ANSWER_SHEET_BUCKET=
MAX_UPLOAD_MB=20

# Feature flags
ENABLE_EXAM_DRAFT_CREATION=false
ENABLE_EXAM_ASSIGNMENT=false
ENABLE_SUBJECTIVE_EVALUATION=false
ENABLE_VISUAL_ANNOTATION=false
